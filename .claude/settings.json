{
  "permissions": {
    "deny": [
      "Edit(./subs/openrocket/**)",
      "Edit(subs/openrocket/**)",
      "Write(./subs/openrocket/**)",
      "Write(subs/openrocket/**)",
      "NotebookEdit(./subs/openrocket/**)",
      "NotebookEdit(subs/openrocket/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__plugin_serena_serena__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-subs.sh\"",
            "timeout": 10,
            "statusMessage": "Checking subs/ write guard"
          }
        ]
      }
    ]
  }
}
